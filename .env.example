# 複製此檔為 .env.local 並填入 Supabase 專案設定
# Supabase 後台：Project Settings → API Keys
# .env.local 已被 .gitignore 排除，請勿將真實金鑰提交到 Git。
# 部署到 Vercel 時，請在 Vercel → Settings → Environment Variables 設定相同變數。

# 專案網址（只填根網址，不要加 /rest/v1/）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 公開金鑰：可送到瀏覽器（二擇一，建議使用新版 publishable key）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 秘密金鑰：僅限伺服器端，切勿加上 NEXT_PUBLIC_ 前綴（二擇一，建議使用新版 secret key）
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=
